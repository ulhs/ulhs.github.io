# === School Data Security (DPA 2012 Compliance) ===

# Ignore any filled SF2 forms or student lists
# *sf2_filled*
# *attendance_report*
# *student_data*
# *.xlsx
# *.csv
# *.pdf

# Allow ONLY the blank template (example: assets/templates/SF2_Blank.xlsx)
# This uses a "negation" rule: ignore all xlsx, but keep the template
!assets/admin/attendance/templates/SF2_Blank.xlsx
!assets/admin/attendance/templates/SF2_Blank_SHS.xlsx
!assets/admin/attendance/templates/SF4_Blank.xlsx
!assets/admin/attendance/templates/SF4_Blank_SHS.xlsx
!assets/documents/Basic-Education-Enrollment-Form.pdf
!assets/documents/BEEF-front.webp
!assets/documents/BEEF-back.webp
!assets/documents/Confirmation-Slip.webp

# Ignore local environment variables (where you store Supabase/Firebase API Keys)
.env
.env.local
.env.*.local

# Ignore any logs or temporary data exports
logs/
*.log
tmp/
dist/

*.sql
!database/create_parent_student_links_table.sql

# Ignore QR Batch Generator page
pages/admin/qr-batch-generator.html

# Ignore Windows thumbnail cache files
*.db

assets/documents/website-audit-report.md
docs/exam-question-update-guide.md